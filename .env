# Variáveis com o prefixo VITE_ são expostas ao navegador.
# Durante o processo de build, o Vite incorpora seus valores diretamente
# no bundle do frontend, tornando-os visíveis para qualquer visitante.
#
# Por padrão, não deveriamos versionar .env,
# aqui isso não faz diferença, qualquer variável útil
# precisaria do prefixo VITE_, o que já a expõe no bundle.
# Dessa forma, faciliamos algumas ações.
#
# NÃO armazene:
# - Tokens de acesso
# - Credenciais de banco de dados
# - Chaves privadas
# - Qualquer outra informação sensível
# ========================================================================
VITE_SITE_URL=http://criec.if.ufrgs.br